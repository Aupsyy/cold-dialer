# Les NOMS des variables seulement. Chacun colle ses valeurs lui-même : dans le tableau de bord Vercel (Settings > Environment
# Variables), ou dans .env.local pour travailler en local. .env.local n'est jamais suivi par git. Ne jamais mettre de valeur ici.

# Supabase (Project Settings > API). La clé service ne porte JAMAIS le préfixe NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# La base de données, en local seulement (tests SQL, imports, graine de démonstration) : jamais sur Vercel.
SUPABASE_DB_URL=
# Certificat racine (PEM) de la base distante, pour vérifier TLS depuis les scripts (import, débrief, installation) ; vide en local.
SUPABASE_DB_CA=

# Téléphonie : seulement celles du fournisseur choisi (config/niche.json, telephonie.fournisseur).
ONOFF_WEBHOOK_TOKEN=
ONOFF_API_KEY=
AIRCALL_WEBHOOK_TOKEN=
AIRCALL_API_ID=
AIRCALL_API_TOKEN=
# Ringover (expérimental) : secret partagé du webhook, 24 caractères au moins, passé dans ?secret=
RINGOVER_WEBHOOK_SECRET=

# Agenda : seulement celles de l'outil choisi (config/niche.json, agenda.fournisseur).
CALENDLY_WEBHOOK_SIGNING_KEY=
ICLOSED_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# Tâches planifiées (purges RGPD, synchronisation de l'agenda Google, reprise de l'audio des appels) : un secret long, tiré au hasard,
# envoyé par Vercel en « Authorization: Bearer ».
CRON_SECRET=
