{
  "name": "cold-dialer",
  "version": "0.1.0",
  "private": true,
  "description": "Poste d'appels de prospection B2B, personnalisable par niche (Next.js, Supabase).",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./scripts/charger-ts.mjs --test tests/*.test.mjs && node scripts/test-publication.mjs",
    "test:sql": "node --env-file-if-exists=.env.local scripts/test-sql.mjs",
    "test:publication": "node scripts/test-publication.mjs",
    "test:base": "node --env-file-if-exists=.env.local --import ./scripts/charger-ts.mjs --test tests/*.test.mjs",
    "install:secrets": "node scripts/install/secrets.mjs",
    "install:verifier": "node scripts/install/verifier.mjs",
    "install:equipe": "node scripts/install/equipe.mjs",
    "install:demo": "node scripts/install/seed-demo.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "next": "15.5.29",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "pg": "8.23.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.32",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    }
  }
}
